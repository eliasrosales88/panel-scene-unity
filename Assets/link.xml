<linker>
    <!--
      Preserve System.Net.Sockets types used by Packages/com.statesync.unity (WsServer)
      from IL2CPP stripping. The Mono backend doesn't need this, but having it costs
      nothing and protects future IL2CPP builds.
    -->
    <assembly fullname="System">
        <type fullname="System.Net.Sockets.TcpListener" preserve="all"/>
        <type fullname="System.Net.Sockets.TcpClient" preserve="all"/>
        <type fullname="System.Net.Sockets.NetworkStream" preserve="all"/>
    </assembly>
</linker>
